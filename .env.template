# Document Filer Configuration Template
# Copy this file to .env and fill in your preferences

# Provider (can also be switched in the GUI dropdown):
#   claude-cli  - Claude Code CLI (`claude -p`), uses your Claude subscription login, no API key
#   codex-cli   - Codex CLI (`codex exec`), uses your ChatGPT subscription login, no API key
#   claude | openai | gemini - provider SDKs, need the matching API key below
VLM_PROVIDER=claude-cli

# API Keys (only needed for the SDK providers; never passed to the CLI providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model Selection (leave CLI models empty to use each CLI's own default)
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-3.1-pro-preview
CLAUDE_CLI_MODEL=
CODEX_CLI_MODEL=

# Max tokens to generate (SDK providers; thinking models need headroom)
VLM_MAX_TOKENS=4096

# Parallel documents (1 = sequential)
VLM_MAX_PARALLEL=1

# Image Processing
# DPI used to render PDF pages
IMAGE_DPI=300
# Maximum image dimension (width or height) in pixels
MAX_IMAGE_DIMENSION=2048
# Number of evenly spaced PDF pages to send (always includes first and last)
PDF_PAGES_TO_EXTRACT=3

# File Organization
# Organized document library: scanned for context, and the base for relative destinations
SOURCE_DIR=~/Documents
# Optional: move files under this base instead of SOURCE_DIR
DEFAULT_DEST_BASE=
# Inbox folder the GUI opens on startup
INPUT_DIR=~/GDrive/SHARED/__IN__

# Folder names to skip when scanning (comma-separated regex, matched against the whole folder name)
# Example: \.git,node_modules,temp,.*_cache
SCAN_IGNORE_PATTERNS=\.git,node_modules,__pycache__,\.pytest_cache,\.vscode,\.idea

# Logging
LOG_LEVEL=INFO
